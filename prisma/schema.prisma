generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String             @unique
  passwordHash           String?
  image                  String?
  status                 UserStatus         @default(OFFLINE)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  receivedFriendRequests FriendRequest[]    @relation("FriendRequestReceiver")
  sentFriendRequests     FriendRequest[]    @relation("FriendRequestSender")
  friendshipsAsUserOne   Friendship[]       @relation("FriendshipUserOne")
  friendshipsAsUserTwo   Friendship[]       @relation("FriendshipUserTwo")
  groupMemberships       GroupMember[]
  ownedGroups            Group[]            @relation("GroupOwner")
  receivedGroupInvites   GroupInvite[]      @relation("GroupInviteReceiver")
  sentGroupInvites       GroupInvite[]      @relation("GroupInviteInviter")
  messages               Message[]
  notifications          Notification[]     @relation("NotificationRecipient")
  pushSubscriptions      PushSubscription[]
  sentNotifications      Notification[]     @relation("NotificationActor")
  deviceKeys             UserDeviceKey[]
  startedCalls           FriendCall[]       @relation("FriendCallCaller")
  receivedCalls          FriendCall[]       @relation("FriendCallReceiver")
  messageReactions       MessageReaction[]
  pinnedMessages         Message[]          @relation("MessagePinnedBy")
  reportedMessages       MessageReport[]    @relation("MessageReportReporter")
  reviewedMessageReports MessageReport[]    @relation("MessageReportReviewer")
  pollVotes              PollVote[]
  voiceSettings          UserVoiceSettings?

  @@index([status])
  @@map("users")
}

model UserVoiceSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique @map("user_id")
  inputDeviceId          String?  @map("input_device_id")
  outputDeviceId         String?  @map("output_device_id")
  inputVolume            Int      @default(100) @map("input_volume")
  outputVolume           Int      @default(100) @map("output_volume")
  inputMode              String   @default("voice_activity") @map("input_mode")
  autoSensitivity        Boolean  @default(true) @map("auto_sensitivity")
  sensitivity            Int      @default(55)
  pushToTalkKey          String?  @map("push_to_talk_key")
  noiseSuppression       Boolean  @default(true) @map("noise_suppression")
  echoCancellation       Boolean  @default(true) @map("echo_cancellation")
  autoGainControl        Boolean  @default(true) @map("auto_gain_control")
  voiceIsolation         Boolean  @default(false) @map("voice_isolation")
  attenuation            Int      @default(0)
  joinMuted              Boolean  @default(false) @map("join_muted")
  joinDeafened           Boolean  @default(false) @map("join_deafened")
  showVoiceWarnings      Boolean  @default(true) @map("show_voice_warnings")
  showSpeakingIndicators Boolean  @default(true) @map("show_speaking_indicators")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_voice_settings")
}

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  receiver   User                @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User                @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("friend_requests")
}

model Friendship {
  id        String   @id @default(cuid())
  userOneId String
  userTwoId String
  createdAt DateTime @default(now())
  userOne   User     @relation("FriendshipUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo   User     @relation("FriendshipUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@map("friendships")
}

model Group {
  id               String          @id @default(cuid())
  name             String
  description      String?
  image            String?
  ownerId          String
  isDirectMessage  Boolean         @default(false) @map("is_direct_message")
  directMessageKey String?         @unique @map("direct_message_key")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  channels         Channel[]
  invites          GroupInvite[]
  members          GroupMember[]
  notifications    Notification[]
  messageReports   MessageReport[]
  owner            User            @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(MEMBER)
  createdAt DateTime  @default(now())
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([role])
  @@map("group_members")
}

model GroupInvite {
  id         String            @id @default(cuid())
  groupId    String
  inviterId  String
  receiverId String
  status     GroupInviteStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  group      Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter    User              @relation("GroupInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  receiver   User              @relation("GroupInviteReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([groupId, receiverId])
  @@index([groupId])
  @@index([inviterId])
  @@index([receiverId])
  @@index([status])
  @@map("group_invites")
}

model Channel {
  id             String          @id @default(cuid())
  groupId        String
  name           String
  type           ChannelType     @default(TEXT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages       Message[]
  notifications  Notification[]
  messageReports MessageReport[]

  @@unique([groupId, name])
  @@index([groupId])
  @@index([type])
  @@map("channels")
}

model Message {
  id               String            @id @default(cuid())
  channelId        String
  senderId         String
  content          String
  replyToMessageId String?           @map("reply_to_message_id")
  pinnedAt         DateTime?         @map("pinned_at")
  pinnedById       String?           @map("pinned_by_id")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  channel          Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender           User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo          Message?          @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]         @relation("MessageReplies")
  pinnedBy         User?             @relation("MessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  notifications    Notification[]
  reactions        MessageReaction[]
  reports          MessageReport[]
  poll             Poll?

  @@index([channelId])
  @@index([channelId, createdAt])
  @@index([senderId])
  @@index([replyToMessageId])
  @@index([pinnedAt])
  @@index([pinnedById])
  @@index([createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

model Poll {
  id        String       @id @default(cuid())
  messageId String       @unique
  question  String
  createdAt DateTime     @default(now())
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]

  @@map("polls")
}

model PollOption {
  id       String     @id @default(cuid())
  pollId   String
  text     String
  position Int
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@index([pollId, position])
  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
  @@index([userId])
  @@map("poll_votes")
}

model MessageReport {
  id           String              @id @default(cuid())
  messageId    String
  reporterId   String
  groupId      String
  channelId    String
  reason       MessageReportReason
  details      String?
  status       MessageReportStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  message      Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter     User                @relation("MessageReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer     User?               @relation("MessageReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  group        Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channel      Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([groupId, status, createdAt])
  @@index([channelId])
  @@index([messageId])
  @@index([reporterId])
  @@index([reviewedById])
  @@map("message_reports")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  groupId   String?
  channelId String?
  messageId String?
  callId    String?          @map("call_id")
  type      NotificationType @default(MESSAGE)
  title     String
  body      String
  href      String
  dataJson  Json?            @map("data_json")
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime         @default(now())
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  channel   Channel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  group     Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  message   Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
  @@index([actorId])
  @@index([callId])
  @@index([groupId])
  @@index([channelId])
  @@index([messageId])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model UserDeviceKey {
  id        String   @id
  userId    String
  publicKey String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeen  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_device_keys")
}

model FriendCall {
  id         String           @id @default(cuid())
  callerId   String
  receiverId String
  roomName   String           @unique
  status     FriendCallStatus @default(RINGING)
  expiresAt  DateTime
  endedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  caller     User             @relation("FriendCallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  receiver   User             @relation("FriendCallReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId, createdAt])
  @@index([receiverId, status, expiresAt])
  @@map("friend_calls")
}

enum UserStatus {
  ONLINE
  OFFLINE
  IDLE
  DO_NOT_DISTURB
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ChannelType {
  TEXT
  VOICE
}

enum NotificationType {
  MESSAGE
  FRIEND_REQUEST
  GROUP_INVITE
  INCOMING_CALL
  MISSED_CALL
  SYSTEM
}

enum FriendCallStatus {
  RINGING
  ACCEPTED
  DECLINED
  MISSED
  ENDED
}

enum MessageReportReason {
  SPAM
  HARASSMENT
  HATE_OR_ABUSE
  NSFW
  OTHER
}

enum MessageReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}
