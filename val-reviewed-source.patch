diff --git a/desktop/package.json b/desktop/package.json
new file mode 100644
index 0000000..6671ed8
--- /dev/null
+++ b/desktop/package.json
@@ -0,0 +1,48 @@
+{
+  "name": "val-desktop",
+  "productName": "VAL",
+  "version": "0.1.6",
+  "description": "VAL for Windows",
+  "author": "Rootonset",
+  "private": true,
+  "main": "main.cjs",
+  "scripts": {
+    "start": "electron .",
+    "test": "node --test tests/*.test.cjs",
+    "setup:build": "node scripts/build-setup-ui.cjs",
+    "setup:preview": "installer\\bin\\VAL-Setup-UI.exe --preview",
+    "predist": "node scripts/check-release.cjs && node scripts/build-setup-ui.cjs",
+    "release:draft": "node scripts/release.cjs",
+    "dist": "electron-builder --win nsis --x64 --publish never"
+  },
+  "devDependencies": {
+    "electron": "43.8.3",
+    "electron-builder": "26.18.0"
+  },
+  "dependencies": { "electron-updater": "6.8.9" },
+  "build": {
+    "appId": "com.rootonset.val",
+    "asar": true,
+    "directories": { "output": "dist" },
+    "files": ["main.cjs", "policy.cjs", "persistent-login.cjs", "updates.cjs", "window-preload.cjs", "desktop-effects.css", "picker/**", "assets/**", "offline.html", "package.json"],
+    "publish": [{ "provider": "github", "owner": "S4DRA", "repo": "Doshab", "releaseType": "release" }],
+    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "assets/val.ico", "artifactName": "VAL-Setup-${version}.${ext}" },
+    "nsis": {
+      "oneClick": false,
+      "perMachine": false,
+      "allowToChangeInstallationDirectory": true,
+      "createDesktopShortcut": true,
+      "deleteAppDataOnUninstall": false,
+      "include": "installer/val-installer.nsh",
+      "installerIcon": "assets/val.ico",
+      "uninstallerIcon": "assets/val.ico",
+      "installerSidebar": "installer/sidebar.bmp",
+      "uninstallerSidebar": "installer/sidebar.bmp",
+      "installerHeader": "installer/header.bmp",
+      "uninstallDisplayName": "VAL",
+      "uninstallUrlInfoAbout": "https://doshab.vercel.app",
+      "multiLanguageInstaller": false,
+      "installerLanguages": ["en_US"]
+    }
+  }
+}
diff --git a/desktop/persistent-login.cjs b/desktop/persistent-login.cjs
new file mode 100644
index 0000000..678eb48
--- /dev/null
+++ b/desktop/persistent-login.cjs
@@ -0,0 +1,69 @@
+const fs = require('node:fs/promises');
+const { dirname } = require('node:path');
+
+const IDLE_LIMIT_MS = 30 * 24 * 60 * 60 * 1000;
+
+function isAuthCookie(name) {
+  return name === 'doshab_session' || /^sb-.+-auth-token(?:\.\d+)?$/.test(name);
+}
+
+function createPersistentLogin({ session, origin, statePath, now = Date.now, files = fs }) {
+  let lastUsedAt = now();
+  let lastSavedAt = 0;
+  let pending = Promise.resolve();
+  let clearing;
+
+  const save = () => {
+    const value = JSON.stringify({ version: 1, lastUsedAt });
+    pending = pending.catch(() => {}).then(async () => {
+      await files.mkdir(dirname(statePath), { recursive: true });
+      await files.writeFile(`${statePath}.tmp`, value, { mode: 0o600 });
+      await files.rename(`${statePath}.tmp`, statePath);
+    });
+    lastSavedAt = now();
+    return pending;
+  };
+
+  const clearAuth = async () => {
+    const cookies = await session.cookies.get({ url: origin });
+    for (const cookie of cookies.filter(({ name }) => isAuthCookie(name))) {
+      await session.cookies.remove(new URL(cookie.path || '/', origin).href, cookie.name);
+    }
+    await session.cookies.flushStore();
+  };
+
+  return {
+    async restore() {
+      let expired = false;
+      try {
+        const saved = JSON.parse(await files.readFile(statePath, 'utf8'));
+        expired = !Number.isFinite(saved.lastUsedAt) || saved.lastUsedAt <= 0 || now() - saved.lastUsedAt >= IDLE_LIMIT_MS;
+      } catch (error) {
+        // A first upgrade adopts the existing browser profile; malformed state
+        // cannot silently extend a previously tracked inactive session.
+        expired = error.code !== 'ENOENT';
+      }
+      if (expired) await clearAuth();
+      lastUsedAt = now();
+      await save();
+      return { expired };
+    },
+    async touch() {
+      const expired = now() - lastUsedAt >= IDLE_LIMIT_MS;
+      if (expired) {
+        clearing ??= clearAuth();
+        try { await clearing; } finally { clearing = null; }
+      }
+      lastUsedAt = now();
+      if (expired || now() - lastSavedAt >= 60_000) await save();
+      return { expired };
+    },
+    async flush() {
+      const results = await Promise.allSettled([save(), session.cookies.flushStore()]);
+      const failed = results.find((result) => result.status === 'rejected');
+      if (failed) throw failed.reason;
+    }
+  };
+}
+
+module.exports = { createPersistentLogin, isAuthCookie, IDLE_LIMIT_MS };
