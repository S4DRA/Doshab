+++ b/desktop/tests/policy.test.cjs
@@ -0,0 +1,24 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { desktopUrl, sameOrigin, externalUrl, permissionAllowed, PRODUCTION_URL } = require('../policy.cjs');
+
+test('packaged app cannot be redirected by an environment variable', () => {
+  assert.equal(desktopUrl(true, 'https://attacker.example'), PRODUCTION_URL);
+});
+test('development permits loopback only', () => {
+  assert.equal(desktopUrl(false, 'http://localhost:3000/login'), 'http://localhost:3000');
+  assert.equal(desktopUrl(false, 'http://127.0.0.1:3000'), 'http://127.0.0.1:3000');
+  for (const url of ['https://attacker.example', 'http://localhost.attacker.example', 'file:///C:/test', 'javascript:alert(1)', 'http://user:pass@localhost']) assert.throws(() => desktopUrl(false, url));
+});
+test('only the exact VAL origin is trusted', () => {
+  assert.equal(sameOrigin(`${PRODUCTION_URL}/dashboard`, PRODUCTION_URL), true);
+  for (const url of ['https://doshab.vercel.app.attacker.example', 'https://doshab.vercel.app@attacker.example', 'http://doshab.vercel.app', 'https://doshab.vercel.app:444', 'data:text/html,hi', 'garbage']) assert.equal(sameOrigin(url, PRODUCTION_URL), false);
+});
+test('external links cannot launch arbitrary local protocols', () => {
+  for (const url of ['https://example.com', 'http://example.com', 'mailto:hello@example.com']) assert.equal(externalUrl(url), true);
+  for (const url of ['file:///C:/Windows/system32/cmd.exe', 'javascript:alert(1)', 'powershell:payload', 'ms-settings:privacy', 'https://user:password@example.com']) assert.equal(externalUrl(url), false);
+});
+test('unneeded permissions are denied', () => {
+  for (const permission of ['media', 'notifications', 'display-capture']) assert.equal(permissionAllowed(permission), true);
+  for (const permission of ['geolocation', 'midiSysex', 'serial', 'usb', 'clipboard-read', 'unknown']) assert.equal(permissionAllowed(permission), false);
+});
diff --git a/desktop/tests/updates.test.cjs b/desktop/tests/updates.test.cjs
new file mode 100644
index 0000000..9513bfc
--- /dev/null
+++ b/desktop/tests/updates.test.cjs
@@ -0,0 +1,78 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { EventEmitter } = require('node:events');
+const { createUpdateController } = require('../updates.cjs');
+
+function setup(packaged = true) {
+  const updater = new EventEmitter();
+  let checks = 0;
+  let installs = 0;
+  let flushed = false;
+  let response = 0;
+  const messages = [];
+  const notices = [];
+  const timers = [];
+  updater.checkForUpdates = async () => { checks++; return { updateInfo: { version: '0.1.4' } }; };
+  updater.quitAndInstall = () => { assert.equal(flushed, true); installs++; };
+  const controller = createUpdateController({ app: { isPackaged: packaged, getVersion: () => '0.1.4' }, updater,
+    getWindow: () => ({}), notify: (...args) => notices.push(args),
+    beforeInstall: async () => { flushed = true; },
+    dialog: { showMessageBox: async (_win, options) => { messages.push(options); return { response }; } },
+    schedule: (fn, delay) => { timers.push({ fn, delay }); return { unref() {} }; },
+    repeat: (fn, delay) => { timers.push({ fn, delay }); return { unref() {} }; }
+  });
+  return { controller, updater, messages, notices, timers, setResponse: (value) => { response = value; }, stats: () => ({ checks, installs }) };
+}
+
+test('automatic checks wait 30 seconds and repeat every six hours', () => {
+  const { controller, timers, updater } = setup();
+  controller.start();
+  assert.deepEqual(timers.map(({ delay }) => delay), [30000, 21600000]);
+  assert.equal(updater.autoDownload, true);
+  assert.equal(updater.autoInstallOnAppQuit, true);
+  assert.equal(updater.allowDowngrade, false);
+});
+test('development builds do not check for updates', async () => {
+  const { controller, timers, stats } = setup(false);
+  controller.start(); await controller.check(true);
+  assert.equal(timers.length, 0); assert.equal(stats().checks, 0);
+});
+test('a downloaded update does not restart an ongoing app or duplicate a download', async () => {
+  const { controller, updater, stats, notices } = setup();
+  updater.emit('update-available');
+  await controller.check();
+  assert.equal(stats().checks, 0);
+  updater.emit('update-downloaded');
+  assert.equal(controller.getState().downloaded, true);
+  assert.equal(stats().installs, 0);
+  assert.equal(notices.length, 1);
+});
+test('install-now waits for confirmation and session flush', async () => {
+  const { controller, updater, stats, setResponse } = setup();
+  updater.emit('update-downloaded');
+  await controller.installNow();
+  assert.equal(stats().installs, 0);
+  setResponse(1);
+  await controller.installNow();
+  assert.equal(stats().installs, 1);
+});
+test('failed background checks remain quiet and permit later retry', async () => {
+  const { controller, updater, messages } = setup();
+  updater.checkForUpdates = async () => { throw new Error('offline'); };
+  await controller.check();
+  assert.equal(messages.length, 0);
+  assert.equal(controller.getState().checking, false);
+  assert.equal(controller.getState().lastError, 'offline');
+  await controller.check(true);
+  assert.equal(messages.length, 1);
+});
+test('concurrent update checks coalesce', async () => {
+  const { controller, updater } = setup();
+  let finish;
+  let checks = 0;
+  updater.checkForUpdates = () => { checks++; return new Promise((resolve) => { finish = resolve; }); };
+  const pending = controller.check();
+  await controller.check();
+  assert.equal(checks, 1);
+  finish({ updateInfo: { version: '0.1.4' } }); await pending;
+});
diff --git a/desktop/tests/window-preload.test.cjs b/desktop/tests/window-preload.test.cjs
new file mode 100644
index 0000000..e1bf71e
--- /dev/null
+++ b/desktop/tests/window-preload.test.cjs
@@ -0,0 +1,148 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+
+function setup({ isMainFrame = true, origin = 'https://doshab.vercel.app', withHeader = true } = {}) {
+  class Element {
+    constructor(tag) { this.tag = tag; this.nodeType = 1; this.children = []; this.dataset = {}; this.attributes = new Map(); this.events = {}; }
+    setAttribute(key, value) { this.attributes.set(key, value); }
+    toggleAttribute(key, value) { if (value) this.attributes.set(key, ''); else this.attributes.delete(key); }
+    get isConnected() { return this === document.body || !!this.parent?.isConnected; }
+    append(child) {
+      if (child.parent) child.parent.children = child.parent.children.filter((item) => item !== child);
+      child.parent = this; this.children.push(child);
+    }
+    attachShadow() { this.shadow = new Element('shadow'); return this.shadow; }
+    addEventListener(name, handler) { this.events[name] = handler; }
+    getClientRects() { return [{}]; }
+    matches() { return this.tag === 'header'; }
+    querySelector() { return this.children.find((item) => item.tag === 'header'); }
+  }
+  const documentEvents = {};
+  let queries = 0;
+  let observations = 0;
+  let disconnections = 0;
+  const document = { body: new Element('body'), documentElement: new Element('html'), hidden: false,
+    createElement: (tag) => new Element(tag),
+    addEventListener: (name, fn) => { documentEvents[name] = fn; }, removeEventListener: (name) => { delete documentEvents[name]; } };
+  const header = new Element('header');
+  if (withHeader) document.body.append(header);
+  document.querySelectorAll = () => { queries++; return header.isConnected ? [header] : []; };
+  const events = {};
+  const calls = [];
+  const listeners = {};
+  const frames = [];
+  let observer;
+  const window = { addEventListener(name, fn) { events[name] = fn; } };
+  const ipcRenderer = {
+    on(name, fn) { listeners[name] = fn; },
+    send(channel) { calls.push({ channel }); },
+    invoke(channel, action) { calls.push({ channel, action }); return Promise.resolve({ maximized: false, fullscreen: false }); }
+  };
+  vm.runInNewContext(fs.readFileSync(path.join(__dirname, '../window-preload.cjs'), 'utf8'), {
+    require: () => ({ ipcRenderer }), process: { isMainFrame, argv: ['--val-origin=https://doshab.vercel.app'] },
+    location: { origin, protocol: 'https:', pathname: '/dashboard' }, window, document, console,
+    getComputedStyle: () => ({ visibility: 'visible' }),
+    requestAnimationFrame: (fn) => { frames.push(fn); return frames.length; }, cancelAnimationFrame() {},
+    MutationObserver: class { constructor(fn) { observer = fn; } observe() { observations++; } disconnect() { disconnections++; } }
+  });
+  events.DOMContentLoaded?.();
+  const host = [...header.children, ...document.body.children].find((item) => item.id === 'val-desktop-controls');
+  return { document, header, events, documentEvents, calls, listeners, host,
+    stats: () => ({ queries, observations, disconnections }),
+    mutate: (addedNodes = [header]) => { observer([{ addedNodes }]); while (frames.length) frames.shift()(); } };
+}
+
+test('controls attach to the existing app header and ignore synthetic clicks', () => {
+  const { header, host, calls } = setup();
+  assert.equal(host.parent, header);
+  const buttons = host.shadow.children.filter((item) => item.tag === 'button');
+  assert.equal(buttons.length, 3);
+  const before = calls.length;
+  buttons[0].events.click({ isTrusted: false });
+  assert.equal(calls.length, before);
+  buttons[0].events.click({ isTrusted: true });
+  assert.equal(calls.at(-1).channel, 'val:window-action');
+  assert.equal(calls.at(-1).action, 'minimize');
+});
+
+test('login fallback moves into the app header when a route loads', () => {
+  const { document, header, host, mutate } = setup({ withHeader: false });
+  assert.equal(host.parent, document.body);
+  assert.equal(host.attributes.has('data-floating'), true);
+  document.body.append(header);
+  mutate();
+  assert.equal(host.parent, header);
+  assert.equal(host.attributes.has('data-floating'), false);
+  const replacement = document.createElement('header');
+  // Simulate React removing the old header, then the route remounting it.
+  header.parent = null;
+  mutate();
+  assert.equal(host.parent, document.body);
+  document.body.append(header);
+  mutate();
+  assert.equal(host.parent, header);
+  assert.equal(replacement.children.length, 0);
+});
+
+test('window state updates restore label and hides controls in fullscreen', () => {
+  const { host, listeners } = setup();
+  const maximize = host.shadow.children.find((item) => item.dataset.action === 'toggle-maximize');
+  listeners['val:window-state']({}, { maximized: true, fullscreen: false });
+  assert.equal(maximize.title, 'Restore window');
+  listeners['val:window-state']({}, { maximized: false, fullscreen: true });
+  assert.equal(host.attributes.has('data-fullscreen'), true);
+});
+
+test('no window controls are injected into subframes or other origins', () => {
+  assert.equal(setup({ isMainFrame: false }).host, undefined);
+  assert.equal(setup({ origin: 'https://evil.example' }).host, undefined);
+});
+
+test('window buttons use explicit CSS line icons without SVG parsing or rebuilding', () => {
+  const { host, listeners } = setup();
+  const buttons = host.shadow.children.filter((item) => item.tag === 'button');
+  assert.equal(buttons[0].children[0].className, 'icon minimize');
+  assert.equal(buttons[1].children[0].className, 'icon maximize');
+  assert.equal(buttons[2].children[0].className, 'icon close');
+  const icon = buttons[1].children[0];
+  listeners['val:window-state']({}, { maximized: true, fullscreen: false });
+  assert.equal(buttons[1].children[0], icon);
+  assert.equal(icon.className, 'icon restore');
+});
+
+test('unrelated mutations do not scan the document during login or normal chat', () => {
+  for (const withHeader of [true, false]) {
+    const { stats, mutate } = setup({ withHeader });
+    const before = stats().queries;
+    for (let i = 0; i < 1000; i++) mutate([{ nodeType: 3 }]);
+    assert.equal(stats().queries - before, 0);
+  }
+});
+
+test('hidden window disconnects control observer and resumes on visibility', () => {
+  const { document, documentEvents, stats, mutate } = setup();
+  const before = stats();
+  document.hidden = true;
+  documentEvents.visibilitychange();
+  assert.equal(stats().disconnections, before.disconnections + 1);
+  assert.equal(document.documentElement.attributes.has('data-val-desktop-hidden'), true);
+  document.hidden = false;
+  documentEvents.visibilitychange();
+  assert.equal(stats().observations, before.observations + 1);
+  assert.equal(document.documentElement.attributes.has('data-val-desktop-hidden'), false);
+  mutate([]);
+});
+
+test('only real user input emits throttled activity without sending credentials', () => {
+  const { documentEvents, calls } = setup();
+  documentEvents.pointerdown({ isTrusted: false });
+  assert.equal(calls.filter(({ channel }) => channel === 'val:activity').length, 0);
+  documentEvents.pointerdown({ isTrusted: true });
+  documentEvents.keydown({ isTrusted: true });
+  const activityCalls = calls.filter(({ channel }) => channel === 'val:activity');
+  assert.equal(activityCalls.length, 1);
+  assert.deepEqual(activityCalls[0], { channel: 'val:activity' });
+});
diff --git a/desktop/updates.cjs b/desktop/updates.cjs
new file mode 100644
index 0000000..de1e826
--- /dev/null
+++ b/desktop/updates.cjs
@@ -0,0 +1,66 @@
+// electron-updater reads the GitHub feed generated by electron-builder.
+// No GitHub credential is embedded or required on a friend's computer.
+function createUpdateController({ app, updater, dialog, getWindow, notify, onState = () => {}, beforeInstall = async () => {}, schedule = setTimeout, repeat = setInterval }) {
+  let checking = false;
+  let downloaded = false;
+  let downloading = false;
+  let lastError = null;
+  let firstTimer;
+  let repeatTimer;
+  const publishState = () => onState({ checking, downloading, downloaded, lastError });
+
+  updater.autoDownload = true;
+  updater.autoInstallOnAppQuit = true;
+  updater.allowPrerelease = false;
+  updater.allowDowngrade = false;
+  // The user explicitly asks to restart; an ordinary update never restarts VAL.
+  updater.on('error', (error) => { lastError = error.message; checking = false; downloading = false; publishState(); });
+  updater.on('update-available', () => { downloading = true; publishState(); });
+  updater.on('update-downloaded', () => {
+    downloaded = true;
+    downloading = false;
+    lastError = null;
+    publishState();
+    notify('VAL update ready', 'It will install when you fully quit VAL. Closing to the tray keeps your call running.');
+  });
+
+  const check = async (manual = false) => {
+    if (!app.isPackaged || checking || downloading || downloaded) return;
+    checking = true;
+    lastError = null;
+    publishState();
+    try {
+      const result = await updater.checkForUpdates();
+      if (manual && result?.updateInfo?.version === app.getVersion()) {
+        await dialog.showMessageBox(getWindow(), { type: 'info', message: 'VAL is up to date.', buttons: ['OK'] });
+      }
+    } catch (error) {
+      lastError = error.message;
+      if (manual) await dialog.showMessageBox(getWindow(), { type: 'info', message: 'Could not check for a VAL update.', detail: 'Try again later. The update release may not be published yet.', buttons: ['OK'] });
+    } finally { checking = false; publishState(); }
+  };
+
+  return {
+    start() {
+      if (!app.isPackaged) return;
+      firstTimer = schedule(() => void check(), 30_000);
+      repeatTimer = repeat(() => void check(), 6 * 60 * 60 * 1000);
+      firstTimer.unref?.();
+      repeatTimer.unref?.();
+    },
+    check,
+    async installNow() {
+      if (!downloaded) return;
+      const { response } = await dialog.showMessageBox(getWindow(), {
+        type: 'question', message: 'Restart VAL to install the update?',
+        detail: 'VAL will close and any active call will end. You will stay signed in.',
+        buttons: ['Later', 'Restart and update'], defaultId: 0, cancelId: 0
+      });
+      if (response === 1) { await beforeInstall(); updater.quitAndInstall(false, true); }
+    },
+    stop() { clearTimeout(firstTimer); clearInterval(repeatTimer); },
+    getState: () => ({ checking, downloading, downloaded, lastError })
+  };
+}
+
+module.exports = { createUpdateController };
diff --git a/desktop/window-preload.cjs b/desktop/window-preload.cjs
new file mode 100644
index 0000000..e2cc9e8
--- /dev/null
+++ b/desktop/window-preload.cjs
@@ -0,0 +1,143 @@
+// Runs in Electron's isolated, sandboxed preload world. Nothing is exposed to
+// website JavaScript: only the three controls below can invoke window actions.
+const { ipcRenderer } = require('electron');
+
+if (process.isMainFrame) {
+  const expectedOrigin = process.argv.find((value) => value.startsWith('--val-origin='))?.slice('--val-origin='.length);
+  const isOffline = location.protocol === 'file:' && location.pathname.endsWith('/offline.html');
+  if (location.origin === expectedOrigin || isOffline) {
+    window.addEventListener('DOMContentLoaded', installControls, { once: true });
+  }
+}
+
+function installControls() {
+  // Capture trusted user activity at most once a minute; never store credentials.
+  let lastActivitySent = 0;
+  const activity = (event) => {
+    if (!event.isTrusted || Date.now() - lastActivitySent < 60_000) return;
+    lastActivitySent = Date.now();
+    ipcRenderer.send('val:activity');
+  };
+  document.addEventListener('pointerdown', activity, { capture: true, passive: true });
+  document.addEventListener('keydown', activity, { capture: true, passive: true });
+  document.documentElement.setAttribute('data-val-desktop-performance', '');
+  const host = document.createElement('span');
+  host.id = 'val-desktop-controls';
+  host.setAttribute('role', 'group');
+  host.setAttribute('aria-label', 'VAL window controls');
+  const root = host.attachShadow({ mode: 'closed' });
+  const style = document.createElement('style');
+  style.textContent = `
+    :host{display:inline-flex!important;align-items:center;gap:6px;flex:0 0 auto!important;margin-left:auto;vertical-align:middle;
+      width:132px!important;max-width:none!important;padding:0!important;align-self:center;white-space:nowrap;
+      color:#cdd0d5;font:12px system-ui,sans-serif;line-height:1;letter-spacing:normal;text-transform:none;}
+    :host([data-floating]){position:fixed;right:12px;top:12px;z-index:2147483647;width:260px!important;}
+    :host([data-floating]) .grip{flex:1;}
+    :host([data-fullscreen]){display:none!important;}
+    .grip{width:18px;height:30px;display:grid;place-items:center;app-region:drag;-webkit-app-region:drag;
+      user-select:none;opacity:.45;cursor:move;}
+    .grip::before{content:'';display:block;width:2px;height:2px;background:currentColor;
+      box-shadow:5px 0 currentColor,0 5px currentColor,5px 5px currentColor,0 -5px currentColor,5px -5px currentColor;}
+    button{box-sizing:border-box;display:grid;place-items:center;width:32px;height:30px;padding:0;cursor:pointer;
+      app-region:no-drag;-webkit-app-region:no-drag;color:#cdd0d5;background:#171a1f;
+      border:1px solid var(--border-soft,var(--val-rule,#555));border-radius:3px;box-shadow:none;overflow:hidden;}
+    button:hover{color:#e2e4e8;background:#30343c;border-color:#666c77;}
+    button:active{transform:translateY(1px);}
+    button:focus-visible{outline:2px solid var(--control,var(--accent,#f55105));outline-offset:3px;}
+    button[data-action=close]:hover{background:#a62d24;border-color:#a62d24;color:#e2e4e8;}
+    .icon{box-sizing:border-box;display:block;width:12px;height:12px;position:relative;pointer-events:none;}
+    .minimize::before{content:'';position:absolute;left:0;right:0;top:6px;height:2px;background:currentColor;}
+    .maximize{border:2px solid currentColor;}
+    .restore::before,.restore::after{content:'';position:absolute;width:8px;height:8px;border:1.5px solid currentColor;}
+    .restore::before{top:0;right:0;border-left:0;border-bottom:0;}
+    .restore::after{left:0;bottom:0;}
+    .close::before,.close::after{content:'';position:absolute;left:5px;top:-1px;width:2px;height:14px;background:currentColor;}
+    .close::before{transform:rotate(45deg);}.close::after{transform:rotate(-45deg);}
+  `;
+  root.append(style);
+  const grip = document.createElement('span');
+  grip.className = 'grip';
+  grip.title = 'Drag to move VAL; double-click to maximize';
+  grip.setAttribute('aria-hidden', 'true');
+  root.append(grip);
+  let maximize;
+  let maximizeIcon;
+  let previousMaximized;
+  let previousFullscreen;
+  const updateState = (state) => {
+    if (!state || typeof state.maximized !== 'boolean') return;
+    if (previousFullscreen !== state.fullscreen) {
+      previousFullscreen = state.fullscreen;
+      host.toggleAttribute('data-fullscreen', state.fullscreen === true);
+    }
+    if (previousMaximized === state.maximized) return;
+    previousMaximized = state.maximized;
+    maximize.title = state.maximized ? 'Restore window' : 'Maximize window';
+    maximize.setAttribute('aria-label', maximize.title);
+    maximizeIcon.className = `icon ${state.maximized ? 'restore' : 'maximize'}`;
+  };
+  for (const [action, label] of [['minimize', 'Minimize window'], ['toggle-maximize', 'Maximize window'], ['close', 'Close VAL to tray']]) {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.dataset.action = action;
+    button.title = label;
+    button.setAttribute('aria-label', label);
+    const icon = document.createElement('span');
+    icon.setAttribute('aria-hidden', 'true');
+    icon.className = `icon ${action === 'toggle-maximize' ? 'maximize' : action}`;
+    button.append(icon);
+    button.addEventListener('click', (event) => {
+      if (!event.isTrusted) return;
+      void ipcRenderer.invoke('val:window-action', action).then(updateState).catch(console.warn);
+    });
+    if (action === 'toggle-maximize') { maximize = button; maximizeIcon = icon; }
+    root.append(button);
+  }
+  ipcRenderer.on('val:window-state', (_event, state) => updateState(state));
+  void ipcRenderer.invoke('val:window-action', 'state').then(updateState).catch(console.warn);
+
+  // Mount inside VAL's existing header, never in a second title-bar layer.
+  // The floating fallback keeps controls reachable during login/offline pages.
+  let frame = 0;
+  let currentHeader = null;
+  const headerSelector = '.dashboard-shell-header, .val-hero-overline';
+  const findHeader = () => [...document.querySelectorAll(headerSelector)]
+    .find((element) => element.getClientRects().length && getComputedStyle(element).visibility !== 'hidden');
+  const place = () => {
+    frame = 0;
+    const header = findHeader();
+    currentHeader = header;
+    host.toggleAttribute('data-floating', !header);
+    (header || document.body).append(host);
+  };
+  const queuePlacement = () => { if (!frame) frame = requestAnimationFrame(place); };
+  const observer = new MutationObserver((records) => {
+    if (document.hidden) return;
+    if (!host.isConnected || currentHeader && !currentHeader.isConnected) { queuePlacement(); return; }
+    if (currentHeader) return;
+    // During login/loading, inspect only newly added elements. Chat text updates
+    // must not trigger a whole-document selector/layout read.
+    if (records.some((record) => [...record.addedNodes].some((node) => node.nodeType === 1 &&
+      (node.matches(headerSelector) || node.querySelector(headerSelector))))) queuePlacement();
+  });
+  const observe = () => observer.observe(document.body, { childList: true, subtree: true });
+  const visibilityChanged = () => {
+    document.documentElement.toggleAttribute('data-val-desktop-hidden', document.hidden);
+    if (document.hidden) {
+      observer.disconnect();
+      cancelAnimationFrame(frame);
+      frame = 0;
+    } else { observe(); queuePlacement(); }
+  };
+  document.addEventListener('visibilitychange', visibilityChanged);
+  document.documentElement.toggleAttribute('data-val-desktop-hidden', document.hidden);
+  if (!document.hidden) observe();
+  window.addEventListener('resize', queuePlacement);
+  window.addEventListener('pagehide', () => {
+    observer.disconnect(); cancelAnimationFrame(frame);
+    document.removeEventListener('visibilitychange', visibilityChanged);
+    document.removeEventListener('pointerdown', activity, true);
+    document.removeEventListener('keydown', activity, true);
+  }, { once: true });
+  place();
+}
