@@ -0,0 +1,49 @@
+/* Doshab comfort pass. Preserve navigation, selected palettes and mobile behavior. */
+html[data-theme] #val-app {
+  --val-paper: #f4f3ed;
+  --val-rule: #cdd2c6;
+  --surface-panel: #f4f3ed;
+  --surface-card: #f4f3ed;
+  --surface-raised: #e8ebe1;
+  --text-muted: #596351;
+  --text-faint: #66705d;
+  --theme-page-grid-gap: 1.25rem;
+}
+html[data-theme] #val-app .val-hero-copy > p { font-size: 14px; line-height: 1.8; max-width: 58ch; color: #535e4b; }
+html[data-theme] #val-app .val-page-hero { clip-path: polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,0 100%); }
+html[data-theme] #val-app .val-hero-overline { color: #5a6551; font-size: 10px; line-height: 1.7; }
+html[data-theme] #val-app :is(.app-card,.app-panel,.app-surface,.app-row) { box-shadow: none !important; }
+html[data-theme] #val-app :is(.app-button-primary,.app-button-secondary,.app-icon-button) { min-height: 44px; box-shadow: none !important; }
+html[data-theme] #val-app :is(.app-button-primary,.app-button-secondary,.app-icon-button):hover { filter: none; transform: none !important; }
+html[data-theme] #val-app :is(.app-button-primary,.app-button-secondary,.app-icon-button):active { transform: translateY(1px) !important; }
+html[data-theme] #val-app .dashboard-main-sidebar.dashboard-main-sidebar { background: #111714 !important; }
+html[data-theme] #val-app .dashboard-brand-lockup { mix-blend-mode: normal; }
+html[data-theme] #val-app .dashboard-main-sidebar .brand-logo-image { mix-blend-mode: normal !important; }
+html[data-theme] #val-app .dashboard-main-sidebar nav[aria-label='Dashboard'] > div { flex-shrink: 0; }
+html[data-theme] #val-app .dashboard-shell-header { min-height: 52px !important; }
+html[data-theme] #val-app .val-chat-panel { background: #f4f3ed !important; }
+html[data-theme] #val-app .val-chat-panel .message-bubble > p { font-size: 15px; line-height: 1.75; color: #303b29 !important; }
+html[data-theme] #val-app .val-chat-panel .message-row:hover,
+html[data-theme] #val-app .val-chat-panel .message-row:focus-within { background: #e9ece2 !important; }
+html[data-theme] #val-app .val-chat-panel .message-actions { border-radius: 3px !important; box-shadow: none !important; }
+html[data-theme] #val-app .val-chat-panel :is(.chat-composer,.message-composer-form textarea) { border-radius: 3px !important; box-shadow: none !important; backdrop-filter: none !important; }
+html[data-theme] #val-app .val-home-section { clip-path: polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,0 100%); }
+html[data-theme] #val-app :is(.app-page-scroll,.message-feed,.dashboard-secondary-sidebar,.dashboard-main-sidebar nav) { scrollbar-width: none; }
+html[data-theme] #val-app :is(.app-page-scroll,.message-feed,.dashboard-secondary-sidebar,.dashboard-main-sidebar nav)::-webkit-scrollbar { display: none; }
+@media(min-width:1180px) {
+  html[data-theme] #val-app .app-page-container { padding: 22px !important; }
+  html[data-theme] #val-app .dashboard-home-stack { gap: 22px !important; }
+  html[data-theme] #val-app .val-home-section { padding: 24px !important; }
+  html[data-theme] #val-app .val-page-hero { padding: 22px 26px 28px; }
+  html[data-theme] #val-app .dashboard-main-sidebar .dashboard-nav-icon-active,
+  html[data-theme] #val-app .dashboard-main-sidebar .dashboard-nav-icon-active:hover { background: var(--val-palette-accent,#ed541f) !important; color: var(--val-palette-text,#101313) !important; box-shadow: none !important; }
+}
+@media(max-width:639px) {
+  html[data-theme] #val-app .val-hero-copy > p { font-size: 13px; line-height: 1.75; }
+  html[data-theme] #val-app .val-chat-panel .message-bubble > p { font-size: 15px; line-height: 1.65; }
+  html[data-theme] #val-app .dashboard-shell-header { min-height: 52px !important; }
+}
+@media(prefers-reduced-motion:reduce) {
+  html[data-theme] #val-app :is(.app-page-scroll,.message-feed) { scroll-behavior: auto !important; }
+  html[data-theme] #val-app :is(.val-page-hero,.app-card,.app-panel,.dashboard-nav-icon,.app-button-primary,.app-button-secondary) { animation: none !important; transition: none !important; }
+}
