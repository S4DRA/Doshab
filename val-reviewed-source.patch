+/* Doshab public surfaces: warm paper, ink structure, focused signal. */
+html[data-theme] .val-public {
+  --public-paper: #f4f3ed;
+  --public-ink: #151918;
+  --public-muted: #5c625c;
+  --public-rule: #d1d3ca;
+  --public-orange: #ed541f;
+  height: 100dvh;
+  overflow-y: auto;
+  overflow-x: hidden;
+  overscroll-behavior-y: contain;
+  scrollbar-width: none;
+  scroll-behavior: smooth;
+  scroll-padding-top: 24px;
+  background: var(--public-paper);
+  color: var(--public-ink);
+  font-family: var(--font-geist-sans), Arial, sans-serif;
+  font-size: 15px;
+  line-height: 1.65;
+  isolation: isolate;
+}
+.val-public::-webkit-scrollbar { display: none; }
+.val-public *, .val-auth * { box-sizing: border-box; }
+.val-public ::selection { background: #ed541f33; color: #151918; }
+.val-public :is(a, button, input, summary):focus-visible, .val-auth :is(a, button, input):focus-visible { outline: 2px solid #b7350c !important; outline-offset: 5px; }
+.val-public a { text-decoration: none; }
+.val-public-wrap { width: min(1248px, calc(100% - 96px)); margin-inline: auto; }
+.val-skip-link { position: absolute; top: 10px; left: 16px; z-index: 100; padding: 12px 18px; background: #f4f3ed; color: #151918; transform: translateY(-180%); }
+.val-skip-link:focus { transform: none; }
+.val-public-header { background: #101413; color: #f4f3ed; }
+.val-public-header-inner { min-height: 96px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
+.val-public-brand { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
+.val-public-logo { width: 52px; height: 52px; }
+.val-public-brand > span:nth-child(2) { font: 900 36px/.9 var(--font-val-display), Impact, sans-serif; letter-spacing: -.02em; }
+.val-public-brand-caption { margin-left: 8px; padding-left: 20px; border-left: 1px solid #49504a; color: #bcc3b9; font: 10px/1.6 var(--font-geist-mono), monospace; text-transform: uppercase; letter-spacing: .04em; }
+.val-public-header nav { display: flex; align-items: center; gap: 30px; font-size: 13px; }
+.val-public-header nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; gap: 16px; color: #cbd0c7; transition: color 140ms ease; }
+.val-public-header nav a:hover, .val-public-header nav a[aria-current] { color: #fff; }
+.val-public-header nav .val-public-nav-login { padding: 0 18px; border: 1px solid #657064; color: #f4f3ed; }
+.val-public-overline { display: flex; justify-content: space-between; gap: 16px; padding-block: 18px; border-bottom: 1px solid var(--public-rule); font: 10px/1.5 var(--font-geist-mono), monospace; text-transform: uppercase; letter-spacing: .06em; color: var(--public-muted); }
+.val-public-hero-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(270px, 1fr); gap: 60px; align-items: center; padding: 64px 0 56px; }
+.val-public-kicker { margin: 0 0 22px; font: 11px/1.6 var(--font-geist-mono), monospace; text-transform: uppercase; letter-spacing: .055em; }
+.val-public-kicker::before { content: ""; display: inline-block; width: 6px; height: 6px; margin: 0 9px 1px 0; background: var(--public-orange); }
+.val-public :is(h1, h2) { margin: 0; font-family: var(--font-val-display), Impact, "Arial Narrow", sans-serif; font-weight: 900; line-height: .96; letter-spacing: -.025em; text-transform: uppercase; }
+.val-public h1 { font-size: clamp(64px, 6.25vw, 96px); }
+.val-public h2 { font-size: clamp(48px, 4.5vw, 68px); }
+.val-public :is(h1, h2) em { font-style: normal; color: #bd4018; }
+.val-public .val-public-lead { margin: 25px 0 28px; max-width: 46ch; font-size: 16px; line-height: 1.75; color: #4e564f; }
+.val-public-actions { display: flex; flex-wrap: wrap; gap: 10px; }
