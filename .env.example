# Copy this file to .env and replace the values for your local PostgreSQL database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/palaver?schema=public"

# Optional fallback used by some hosted providers for direct database access.
# Prisma config prefers DATABASE_URL, then falls back to DIRECT_URL when needed.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/palaver?schema=public"

# Use a strong random value with at least 32 characters.
SESSION_SECRET="Z1ggxv5f5N/ruBliM5GUZe4lUNSwDaXrlxndKyrwD0gb0AMMVY8HHzGiCewxmoHp"

# LiveKit credentials are used only on the server to mint room tokens.
LIVEKIT_URL="wss://your-livekit-host"
LIVEKIT_API_KEY="replace-with-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-livekit-api-secret"
