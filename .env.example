# Copy this file to .env and replace the values for your local PostgreSQL database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Optional fallback used by some hosted providers for direct database access.
# Prisma config prefers DATABASE_URL, then falls back to DIRECT_URL when needed.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Runtime database connection timeout in milliseconds.
DATABASE_CONNECTION_TIMEOUT_MS="1000"

# Public Supabase values used only by the browser realtime listener.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Use a strong random value with at least 32 characters.
SESSION_SECRET="replace-with-a-strong-random-secret-at-least-32-characters"

# LiveKit credentials are used only on the server to mint room tokens.
LIVEKIT_URL="wss://your-livekit-host"
LIVEKIT_API_KEY="replace-with-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-livekit-api-secret"
