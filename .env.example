# Public browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only database values
DATABASE_URL=
DIRECT_URL=
DATABASE_CONNECTION_TIMEOUT_MS=20000

# Server-only auth/session signing
SESSION_SECRET=

# Temporary local-development auth bypasses. Keep unset in production.
ENABLE_DEV_EMAIL_AUTH_BYPASS=false
ENABLE_DEV_PASSWORD_RESET=false
ENABLE_EMAIL_PASSWORD_RESET=false
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated mediasoup service. Keep MEDIA_AUTH_SECRET server-only and use the
# same value in the Next.js process and media-server process.
NEXT_PUBLIC_MEDIA_SERVER_URL=http://localhost:3001
MEDIA_SERVER_PORT=3001
MEDIA_SERVER_ALLOWED_ORIGIN=http://localhost:3000
MEDIA_AUTH_SECRET=
# In development this is usually 127.0.0.1. In production bind to the host
# interface and set the publicly routable address below (never localhost).
MEDIASOUP_LISTEN_IP=127.0.0.1
MEDIASOUP_ANNOUNCED_ADDRESS=
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# Server-only key with YouTube Data API v3 enabled (required for music search).
YOUTUBE_API_KEY=
# Optional ISO country code for YouTube availability/chart filtering.
YOUTUBE_REGION_CODE=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
