# Public browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only database values
DATABASE_URL=
DIRECT_URL=
DATABASE_CONNECTION_TIMEOUT_MS=20000

# Server-only auth/session signing
SESSION_SECRET=

# Temporary local-development auth bypasses. Keep unset in production.
ENABLE_DEV_EMAIL_AUTH_BYPASS=false
ENABLE_DEV_PASSWORD_RESET=false
ENABLE_EMAIL_PASSWORD_RESET=false
SUPABASE_SERVICE_ROLE_KEY=

# Server-only LiveKit credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Server-only key with YouTube Data API v3 enabled (required for music search).
YOUTUBE_API_KEY=
# Optional ISO country code for YouTube availability/chart filtering.
YOUTUBE_REGION_CODE=
# Configure a signed LiveKit webhook at your VAL origin + /api/livekit/webhook
# using the same LiveKit API key above. No additional webhook secret is required.

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
