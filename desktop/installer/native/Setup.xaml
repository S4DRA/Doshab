<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VAL Setup" Width="1000" Height="660" MinWidth="820" MinHeight="580"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0D0F12" Foreground="#E9E9E6" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#F55105"/>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#160C06"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="18,0">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#FF6B27"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Quiet" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A9AEB8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="QuietSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="QuietSurface" Property="Background" Value="#292D34"/><Setter Property="Foreground" Value="#ECEDEA"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C5C8CE"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="4" BorderBrush="#525965" BorderThickness="1" Background="#101215" VerticalAlignment="Center">
            <Path x:Name="Tick" Data="M 3,7 L 6,10 L 12,4" Stroke="#1B0E06" StrokeThickness="1.8" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Storyboard x:Key="Ambient" Timeline.DesiredFrameRate="30" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="OrbitRotor" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:36" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="SignalRing" Storyboard.TargetProperty="Opacity" From="0.22" To="0.7" Duration="0:0:3.6" AutoReverse="True" RepeatBehavior="Forever"/>
    </Storyboard>
    <Storyboard x:Key="Working" Timeline.DesiredFrameRate="30" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="ProgressLight" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-90" To="300" Duration="0:0:1.7" RepeatBehavior="Forever"/>
    </Storyboard>
  </Window.Resources>
  <Border BorderBrush="#2A2D34" BorderThickness="1">
    <Grid x:Name="Root" ClipToBounds="True">
      <Grid.Background><RadialGradientBrush Center="0.21,0.46" GradientOrigin="0.21,0.46" RadiusX="0.69" RadiusY="0.9">
        <GradientStop Color="#1A1C21" Offset="0"/><GradientStop Color="#0D0F12" Offset="0.78"/>
      </RadialGradientBrush></Grid.Background>
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Grid x:Name="WindowHeader" Background="Transparent" Margin="30,0,16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="HeaderLogo" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="VAL" FontSize="17" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <Border Width="1" Height="16" Background="#393E47" Margin="17,0"/>
          <TextBlock Text="SETUP" FontFamily="Consolas" FontSize="10" Foreground="#959DA9" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="MinimizeButton" Style="{StaticResource Quiet}" Width="34" Height="30" ToolTip="Minimize" AutomationProperties.Name="Minimize setup"><Path Data="M 0,0 L 10,0" Stroke="#CDD0D5" StrokeThickness="1.5"/></Button>
          <Button x:Name="CloseButton" Style="{StaticResource Quiet}" Width="34" Height="30" Margin="4,0,0,0" ToolTip="Close" AutomationProperties.Name="Close setup"><Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="#CDD0D5" StrokeThickness="1.5"/></Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="46,8,46,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="354"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,32,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
              <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock Text="A LITTLE CLOSER." FontFamily="Consolas" FontSize="10" Foreground="#A4AAB4"/>
            </StackPanel>
            <TextBlock Text="Your people.&#10;One signal." FontSize="44" FontWeight="SemiBold" LineHeight="49" LineStackingStrategy="BlockLineHeight"/>
          </StackPanel>
          <Viewbox Grid.Row="1" Stretch="Uniform" Margin="-18,0,-4,0" ClipToBounds="True">
            <Canvas x:Name="SignalScene" Width="420" Height="266" ClipToBounds="True">
              <Ellipse Canvas.Left="15" Canvas.Top="-62" Width="390" Height="390" Stroke="#22262E" StrokeThickness="1"/>
              <Ellipse Canvas.Left="61" Canvas.Top="-16" Width="298" Height="298" Stroke="#2A2F38" StrokeThickness="1" StrokeDashArray="1,8"/>
              <Ellipse x:Name="SignalRing" Canvas.Left="108" Canvas.Top="31" Width="204" Height="204" Stroke="#5B392A" StrokeThickness="1" Opacity="0.6"/>
              <Canvas x:Name="OrbitRotor" Width="420" Height="266" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform><RotateTransform Angle="0" CenterX="0" CenterY="0"/></Canvas.RenderTransform>
                <Ellipse Canvas.Left="351" Canvas.Top="130" Width="5" Height="5" Fill="{StaticResource Accent}"/>
                <Ellipse Canvas.Left="61" Canvas.Top="130" Width="3" Height="3" Fill="#697181"/>
              </Canvas>
              <Image x:Name="HeroLogo" Canvas.Left="32" Canvas.Top="-45" Width="356" Height="356" RenderOptions.BitmapScalingMode="HighQuality"/>
              <Border Canvas.Left="158" Canvas.Top="230" Background="#15171C" BorderBrush="#323640" BorderThickness="1" CornerRadius="12" Padding="11,5">
                <TextBlock Text="SIGNAL / VAL" FontFamily="Consolas" FontSize="9" Foreground="#9CA5B3"/>
              </Border>
            </Canvas>
          </Viewbox>
          <StackPanel Grid.Row="2" Margin="0,8,0,12">
            <TextBlock Text="A place for every conversation." FontSize="14" Foreground="#ADB3BE"/>
            <TextBlock Text="VOICE    /    MESSAGES    /    SPACES" Margin="0,9,0,0" FontFamily="Consolas" FontSize="9" Foreground="#687281"/>
          </StackPanel>
        </Grid>
        <Border Grid.Column="1" Background="#16191E" BorderBrush="#2C313A" BorderThickness="1" CornerRadius="16" Padding="27" VerticalAlignment="Center">
          <Grid>
            <StackPanel x:Name="WelcomePanel">
              <TextBlock Text="01 / YOUR DESKTOP" FontFamily="Consolas" FontSize="10" Foreground="#919AA8" Margin="0,0,0,18"/>
              <TextBlock Text="Make yourself&#10;at home." FontSize="32" FontWeight="SemiBold" LineHeight="38" LineStackingStrategy="BlockLineHeight"/>
              <TextBlock Text="Install VAL and pick up where you left off." FontSize="13" Foreground="#A8B0BD" TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,23"/>
              <Border Background="#101318" BorderBrush="#303640" BorderThickness="1" CornerRadius="8" Padding="13,10" Margin="0,0,0,17">
                <StackPanel>
                  <DockPanel><TextBlock Text="INSTALL LOCATION" FontFamily="Consolas" FontSize="9" Foreground="#7C8798" VerticalAlignment="Center"/>
                    <Button x:Name="ChangeFolderButton" Style="{StaticResource Quiet}" Content="Change" FontSize="10" HorizontalAlignment="Right" Padding="6,2" Margin="8,0,0,0"/>
                  </DockPanel>
                  <TextBlock x:Name="PathText" Text="AppData\Local\Programs\VAL" FontSize="10" Foreground="#B8C0CD" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
              <CheckBox x:Name="DesktopShortcut" IsChecked="True" Content="Add a desktop shortcut" Margin="0,0,0,22"/>
              <TextBlock x:Name="WelcomeNotice" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" LineHeight="16" Foreground="#F6AE84" Margin="0,0,0,14"/>
              <Button x:Name="InstallButton" Style="{StaticResource Action}" Content="Install VAL   →"/>
              <TextBlock Text="Your account and conversations stay yours." FontSize="10" Foreground="#7E8897" HorizontalAlignment="Center" Margin="0,13,0,0"/>
            </StackPanel>
            <StackPanel x:Name="InstallingPanel" Visibility="Collapsed">
              <TextBlock Text="02 / MAKING ROOM" FontFamily="Consolas" FontSize="10" Foreground="#919AA8" Margin="0,0,0,24"/>
              <TextBlock Text="Finding your&#10;frequency." FontSize="32" FontWeight="SemiBold" LineHeight="38" LineStackingStrategy="BlockLineHeight"/>
              <TextBlock Text="VAL is settling into your desktop." FontSize="13" Foreground="#A8B0BD" TextWrapping="Wrap" LineHeight="20" Margin="0,18,0,32"/>
              <Border Background="#30353E" Height="4" CornerRadius="2" ClipToBounds="True">
                <Canvas><Border x:Name="ProgressLight" Background="{StaticResource Accent}" Width="84" Height="4" CornerRadius="2"><Border.RenderTransform><TranslateTransform X="-90"/></Border.RenderTransform></Border></Canvas>
              </Border>
              <TextBlock x:Name="ProgressText" Text="Installing application files…" FontSize="12" Foreground="#CDD1D9" Margin="0,16,0,12"/>
              <TextBlock Text="This window will let you know when VAL is ready.&#10;No need to do anything else." FontSize="11" Foreground="#7E8897" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,25"/>
              <Border BorderBrush="#30353E" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                <TextBlock Text="Your next conversation starts here." FontSize="11" Foreground="#969FAE"/>
              </Border>
            </StackPanel>
            <StackPanel x:Name="ReadyPanel" Visibility="Collapsed">
              <TextBlock Text="03 / ALL SET" FontFamily="Consolas" FontSize="10" Foreground="#919AA8" Margin="0,0,0,26"/>
              <Border Background="#30251D" Width="49" Height="49" CornerRadius="25" HorizontalAlignment="Left" Margin="0,0,0,24"><Path Data="M 0,9 L 7,16 L 22,0" Stroke="{StaticResource Accent}" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Your space&#10;is ready." FontSize="32" FontWeight="SemiBold" LineHeight="38" LineStackingStrategy="BlockLineHeight"/>
              <TextBlock Text="Sign in, find your people, and make yourself at home." FontSize="13" Foreground="#A8B0BD" TextWrapping="Wrap" LineHeight="20" Margin="0,17,0,30"/>
              <Button x:Name="LaunchButton" Style="{StaticResource Action}" Content="Open VAL   →"/>
              <Button x:Name="FinishButton" Style="{StaticResource Quiet}" Content="I'll open it later" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
              <TextBlock Text="SETUP PAUSED" FontFamily="Consolas" FontSize="10" Foreground="#F6AE84" Margin="0,0,0,25"/>
              <TextBlock Text="Let's try&#10;that again." FontSize="32" FontWeight="SemiBold" LineHeight="38" LineStackingStrategy="BlockLineHeight"/>
              <TextBlock x:Name="ErrorText" Text="VAL could not finish installing. Close setup and try again." TextWrapping="Wrap" FontSize="13" Foreground="#A8B0BD" LineHeight="20" Margin="0,20,0,30"/>
              <Button x:Name="ErrorCloseButton" Style="{StaticResource Action}" Content="Close setup"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="2" Margin="30,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"><Rectangle Fill="{StaticResource Accent}" Width="17" Height="2" Margin="0,0,10,0"/>
          <TextBlock Text="ROOTONSET" FontFamily="Consolas" FontSize="9" Foreground="#87919F"/>
        </StackPanel>
        <TextBlock x:Name="VersionText" Text="VAL / WINDOWS 64-BIT" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="9" Foreground="#6E7887"/>
      </Grid>
    </Grid>
  </Border>
</Window>
